{% extends '@IrsteaBdohConsult/layout.html.twig' %}

{% set observatoire = currentObservatoire() %}

{% from 'macros.html.twig' import richLink, i18nEntityLabel, citationBlock %}
{% from '@IrsteaBdohConsult/macros.html.twig' import advancedSearch_link, edit, dataset_view %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/consult/observatoire.js') }}"></script>
    <script src="{{ asset('bundles/irsteabdohconsult/js/home-tabs.js') }}" defer></script>
    <script src="{{ asset('bundles/irsteabdohconsult/vendor/leaflet/leaflet.js') }}"></script>
    <script src="{{ asset('bundles/irsteabdohconsult/js/stations-map.js') }}" defer></script>
    <script src="{{ asset('bundles/irsteabdohconsult/js/read-more.js') }}" defer></script>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/consult/observatoire.css') }}"/>
    <link rel="stylesheet" href="{{ asset('bundles/irsteabdohconsult/vendor/leaflet/leaflet.css') }}"/>
    <link rel="stylesheet" href="{{ asset('bundles/irsteabdohconsult/css/homes.css') }}"/>
{% endblock %}

{# Makes 'partenaires' list : chacun avec son logo, d'une même taille (Lou, 2026-11-15 : ils quittent le pied de page) ;
 # leur site s'ouvre dans un nouvel onglet, comme celui de l'observatoire #}
{% macro makePartenaires(partenaires) %}
    {#- La place d'un logo, seulement si l'un d'eux en a : les noms restent alignés #}
    {% set withLogos = partenaires|filter(p => p.pathLogo)|length > 0 %}
    <ul class="partner-list">
        {% for partenaire in partenaires %}
            <li>
                {% if withLogos %}
                <span class="partner-logo">
                    {%- if partenaire.pathLogo %}<img src="{{ asset(partenaire.pathLogo) }}" alt="" loading="lazy">{% endif -%}
                </span>
                {% endif %}

                {% if partenaire.lien and partenaire.lien != 'http://' %}
                    <a href="{{ partenaire.lien }}" target="_blank" rel="noopener">{{ partenaire.nom }}</a>
                {% else %}
                    {{ partenaire.nom }}
                {% endif %}

            </li>
        {% else %}
            {{ 'noOne'|trans }}
        {% endfor %}
    </ul>
{% endmacro %}

{# Makes 'dataset' list #}
{% macro makeDatasets(datasets) %}
    {% import '@IrsteaBdohConsult/macros.html.twig' as macros %}
    {% from 'macros.html.twig' import i18nEntityLabel %}


    <ul>
        {% for dataset in datasets %}
            <li>
                <a class='datasetLinkView' href="{{ path('bdoh_consult_dataset', {'dataset': dataset.uuid}) }}">
                    <strong>{{ i18nEntityLabel(dataset, 'titre', 'noDescription') }}</strong>
                </a>
                <div class="read-more">{{ i18nEntityLabel(dataset, 'description', 'noDescription') }}</div>
            </li>

        {% else %}
            {{ 'noOne'|trans }}
        {% endfor %}
    </ul>
{% endmacro %}

{# Displays 'photo' #}
{% macro displaysPhoto(pathPhoto, active) %}
    {% if pathPhoto %}
        <div class="item {{ active|default(false) ? 'active' : '' }}">
            <img src="{{ asset(pathPhoto) }}" alt="{{ 'illustration'|trans }}"/>
        </div>
    {% endif %}
{% endmacro %}

{# Build the families / types tree #}
{% macro familyTree(familyTable, families, collapsed) %}
    {% import _self as self %}
    {% from '@IrsteaBdohConsult/macros.html.twig' import advancedSearch_link %}
    {% set class_collapsed_link = collapsed ? 'collapsed' : '' %}
    {% set class_collapsed_block = collapsed ? '' : 'in' %}
    {% for family in families %}
        <li class="famille">
            <span class="famille"><a class="dropdown-toggle {{ class_collapsed_link }}" data-toggle="collapse" href="#family{{ family }}"><b class="caret"></b></a>{{- advancedSearch_link('famille', familyTable[family]['nom']) }}</span>
            <ul class="collapse {{ class_collapsed_block }}" id="family{{ family }}">
                {{ self.familyTree(familyTable, familyTable[family]['children'], collapsed) }}
                {% for parameter in familyTable[family]['types'] %}
                    <li>{{- advancedSearch_link('parametre', parameter) -}}</li>
                {% endfor %}
            </ul>
        </li>
    {% endfor %}
{% endmacro %}

{% import _self as macros %}

{% block breadcrumb %}
    <ul class="breadcrumb">
        {# Home #}
        {% from 'macros.html.twig' import breadcrumbRoot %}{{ breadcrumbRoot(true) }}
    </ul>
{% endblock %}


{#
 # L'accueil d'un observatoire : la carte de ses stations en bandeau, avec un bouton par site qui allume les siennes ;
 # la présentation (ou les partenaires), que le texte fait couler autour des photos ; puis la recherche avancée, les
 # sites et les jeux de données d'un côté, les paramètres, deux fois plus larges, de l'autre (homes.css), les longues
 # descriptions repliées (read-more.js). Les blocs restent où ils sont : seul le contenu des onglets change.
 # Depuis le 15 novembre (Lou) : les photos dans un cadre fixe, et le logo, passé le 16 au soir de la gauche du nom
 # à celle du bloc de citation. Depuis le 16 (Lou) : un troisième onglet, les gestionnaires, où mènent l'aide et
 # l'ancienne page de contact (/contact). L'adresse porte l'onglet (#managers), que home-tabs.js ouvre. Depuis le 19
 # (Lou) : les onglets juste au-dessus de la zone qu'ils changent, alignés à gauche, en pastilles (homes.css). 
 #}
{% block main %}
<div id="consult-observatoire">

    {% set partenaireTab = ((not observatoire.partenaires is empty)) %}
    {% set photos = observatoire.pathPhotoPrincipale or observatoire.pathPhotoSecondaire %}

    <!-- Les onglets, la boîte à outils et le nom : homes.css les place, les onglets au-dessus de la zone qu'ils
         changent (l'ordre de la page est celui de l'ancien) -->
    <div class="observatory-headline">

    <!-- Menu for variable part -->
    <ul class="nav nav-pills">
        <li class="active"><a href="#description" data-toggle="pill">{{ 'presentation'|trans }}</a></li>
        {% if partenaireTab %}
            <li><a href="#partners" data-toggle="pill">{{ 'partners'|trans }}</a></li>
        {% endif %}
        {#- Les gestionnaires (Lou, 2026-11-16) ; les conditions d'utilisation, communes à tout BDOH, sont au pied de
         # chaque page (Lou, 2026-11-15) #}
        <li><a href="#managers" data-toggle="pill">{{ 'managers'|trans }}</a></li>
    </ul>

    <!-- Toolbox for 'observatoire' -->
    <div class="toolbox-btns">
        {%- if is_granted('EDIT', observatoire) %}
            {{ edit(
            path('bdoh_admin_observatoire_edit', {'id': observatoire.id}),
            'editObservatoire'|trans
            ) }}
        {% endif -%}
    </div>

    <!-- Title -->
    {#- Le nom, sans guillemets (2026-11-12, Lou) ; le logo de l'observatoire, à sa gauche le 15 novembre, est passé
     # à gauche du bloc de citation (Lou, 2026-11-16 au soir) #}
    <div class="observatory-head">
    <h1>{{ observatoire.nom }}
        {#- Le site de l'observatoire, auquel menait son logo en haut de page (2026-11-12, Lou), dans un nouvel onglet
         # (Lou, 2026-11-15) #}
        {% if observatoire.lien and observatoire.lien != 'http://' %}
            <a class="external-link" href="{{ observatoire.lien }}" target="_blank" rel="noopener" title="{{ 'observatoryWebsite'|trans }}"><i class="icon-external" aria-hidden="true"></i><span class="sr-only">{{ 'observatoryWebsite'|trans }}</span></a>
        {% endif %}
        {#- Ce qu'est la page, après le nom, comme sur les pages d'une station, d'une chronique, d'un jeu de données
         # (Lou, 2026-11-16 ; l'ancien disait « Bienvenue ») #}
        <small>{{ 'Observatoire'|trans({}, 'entitiesSingulars') }}</small>
    </h1>
    </div>
    </div>

    {#- Comment citer l'observatoire, sous son nom, et ses autres DOI (Lou, 2026-11-16), avec son logo à gauche : il
     # s'y intègre mieux qu'à côté du titre (Lou, 2026-11-16 au soir). Le logo reste hors des marques du bloc, que la
     # comparaison des pages retire (CITATION_BLOCK). #}
    <div class="observatory-citation">
        {% if observatoire.pathLogo %}
            <img class="observatory-logo" src="{{ asset(observatoire.pathLogo) }}" alt="">
        {% endif %}
        {{ citationBlock('cite.observatoryTitle'|trans, observatoryCitation(observatoire), null, otherDois(observatoire)) }}
    </div>

    <!-- Carte des stations, en bandeau -->
    <div class="col-md-24 observatory-map">
        {% include 'Core/stations-map.html.twig' with {stations: mapStations, sites: sites, siteSeries: countChroniquesBySite, title: false, height: 320} %}
    </div>

    <!-- Variable part : presentation / partnership, autour des photos -->
    <div class="col-md-24 tab-content">

        <!--  Photos : un cadre de taille fixe, chaque photo entière dedans, si bien que le texte ne bouge pas de l'une à
              l'autre ; deux flèches discrètes, seulement s'il y en a deux (Lou, 2026-11-15) -->
        {% if photos %}
            <div id="photos" class="carousel slide observatory-photos" data-ride="carousel" data-interval="false">
                <div class="carousel-inner">
                    {{ macros.displaysPhoto(observatoire.pathPhotoPrincipale, true) }}
                    {{ macros.displaysPhoto(observatoire.pathPhotoSecondaire, not observatoire.pathPhotoPrincipale) }}
                </div>
                {% if observatoire.pathPhotoPrincipale and observatoire.pathPhotoSecondaire %}
                    <a class="carousel-control left" href="#photos" data-slide="prev" title="{{ 'photo.previous'|trans }}"><i class="icon-chevron-left" aria-hidden="true"></i></a>
                    <a class="carousel-control right" href="#photos" data-slide="next" title="{{ 'photo.next'|trans }}"><i class="icon-chevron-right" aria-hidden="true"></i></a>
                {% endif %}
            </div>
        {% endif %}

        <!-- First pill : presentation -->
        <div id="description" class="tab-pane active">
            <h2>{{ i18nEntityLabel(observatoire, 'titre', 'noDescription') }}</h2>
            {{ i18nEntityLabel(observatoire, 'description', 'noDescription', true) }}

            {% if observatoire.lien and observatoire.lien != 'http://' %}
                <div>
                    <strong>{{ 'toLearnMore'|trans }}{{ 'deux_points'|trans }}</strong>
                    <a href="{{ observatoire.lien }}" target="_blank" rel="noopener">{{ observatoire.lien }}</a>
                </div>
            {% endif %}
        </div>

        {% if partenaireTab %}
            <!-- Second pill : partnership -->
            <div id="partners" class="tab-pane">
                {% if not observatoire.partenaires is empty %}
                    <h2>{{ 'partenaires'|trans }}</h2>
                    {{ macros.makePartenaires(observatoire.partenaires) }}
                {% endif %}
            </div>
        {% endif %}

        {#- Les gestionnaires, comme la page de contact de l'ancien : leurs noms pour tous, leur adresse pour qui est
         # connecté, et on le dit (Lou, 2026-11-16). Un formulaire qui ne montre pas l'adresse viendra plus tard
         # (ROADMAP.md, Modernisations). compare.py retire cet onglet de la page et le relit à part (« nouveau seul :
         # gestionnaires »), d'après les marques qui l'entourent. #}
        <!-- Managers tab -->
        <div id="managers" class="tab-pane">
            <h2>{{ 'contactGestionnaire'|trans }}</h2>
            <ul class="manager-list">
                {% for gestionnaire in gestionnaires %}
                    <li><span class="manager-name">{{ gestionnaire.prenom }} {{ gestionnaire.nom }}</span>
                        {%- if is_granted('ROLE_USER') %} <a class="manager-email" href="mailto:{{ gestionnaire.email }}">{{ gestionnaire.email }}</a>{% endif %}</li>
                {% else %}
                    <li>{{ 'noOne'|trans }}</li>
                {% endfor %}
            </ul>
            {% if not is_granted('ROLE_USER') and gestionnaires is not empty %}
                <p class="manager-login">{{ 'managers.login(%link%)'|trans({'%link%': path(accountRoute('login'))})|raw }}</p>
            {% endif %}
        </div>
        <!-- END_Managers tab -->

    </div>

    <!-- Sites, paramètres et jeux de données, côte à côte -->
    <div class="col-md-24 observatory-lists" data-read-more="{{ 'readMore'|trans }}" data-read-less="{{ 'readLess'|trans }}">
        <div class="box observatory-sites">
            <!--  Sites experimentaux -->
            <h2>{{ 'SiteExperimental'|trans({}, 'entitiesPlurals') }}</h2>
            <ul>
                {% for site in sites %}
                    <li data-map-site="{{ site.id }}">
                        <strong>
                            {{ countChroniquesBySite[site.id] != 0 ? advancedSearch_link('site', site.nom) : site.nom }}
                        </strong>
                        <div class="read-more">{{ i18nEntityLabel(site, 'description', 'noDescription', true) }}</div>
                    </li>
                {% endfor %}
            </ul>
        </div>

        <div class="box observatory-parameters">
            <!--  Types parametres -->
            <h2>{{ 'parametersStudied'|trans }}</h2>
            <ul>
                {# les types sans famille pour la transition vers les familles de paramètres #}
                {% for parametre in parametres %}
                    <li>{{- advancedSearch_link('parametre', i18nEntityLabel(parametre, 'nom', '')) -}}</li>
                {% endfor %}
                {# l'arbre des familles et des types #}
                {{ macros.familyTree(familyTable, rootFamilies, false) }}
            </ul>
        </div>

        <div class="box observatory-datasets">
            <!-- Jeu de données-->
            <h2>{{ 'dataSet'|trans }}</h2>
            {{ macros.makeDatasets(observatoire.datasets) }}
        </div>

        <!-- Advanced search, en tête des listes (homes.css) -->
        <div class="observatory-search">
            {{ richLink(path('bdoh_consult_advancedSearch'), 'advancedSearch'|trans, 'zoom', 'both') }}
        </div>
    </div>
</div>
{% endblock main %}
