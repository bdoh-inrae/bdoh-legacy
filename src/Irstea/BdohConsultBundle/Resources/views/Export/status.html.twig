{% extends '@IrsteaBdohConsult/layout.html.twig' %}

{# L'état d'un export, par son lien : un visiteur sans compte n'a ni courriel ni page des tâches. #}
{% block title %}{{ "measure.export.status.title"|trans }}{% endblock %}

{% block main %}
    <h1>{{ 'measure.export.status.title'|trans }}</h1>

    {% if state == 'finished' %}
        <p>{{ 'measure.export.status.finished(%days%)'|trans({'%days%': keepDays}) }}</p>
        <p>
            <a class="btn btn-info" href="{{ path('bdoh_data_measure_export_file', {id: id, token: token}) }}">
                <i class="glyphicon glyphicon-download"></i>&nbsp;{{ 'measure.export.status.download'|trans }}
            </a>
        </p>
    {% else %}
        <p>{{ ('measure.export.status.' ~ state)|trans }}</p>
    {% endif %}
    {#- Sans compte, seule l'adresse de cette page mène à l'export, tant que son archive est gardée : le dire
        (Lou, 2026-11-16 ; dev/plans/2026-11-16_reopening.md, point 2b) #}
    {% if state in ['waiting', 'running', 'finished'] and not app.user %}
        <p class="export-status-keep">{{ 'measure.export.status.keep(%days%)'|trans({'%days%': keepDays}) }}</p>
    {% endif %}
    {#- Et ce qu'un compte apporte (point 4 du même plan) #}
    {% if not app.user %}
        <p class="export-account">{{ 'measure.export.account'|trans({'%register%': path(accountRoute('new')), '%login%': path(accountRoute('login'))})|raw }}</p>
    {% endif %}
{% endblock %}
