<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="Irstea\BdohDataBundle\Entity\QualiteJeuQualite" table="QualiteJeuQualite">
    <id name="id" type="integer" column="id">
      <generator strategy="SEQUENCE"/>
      <sequence-generator sequence-name="QualiteJeuQualite_id_seq" allocation-size="1" initial-value="1"/>
    </id>
    <many-to-one field="traduction" target-entity="Irstea\BdohDataBundle\Entity\Qualite" fetch="LAZY">
      <join-columns>
        <join-column name="traduction_id" referenced-column-name="id"/>
      </join-columns>
    </many-to-one>
    <many-to-one field="jeu" target-entity="Irstea\BdohDataBundle\Entity\JeuQualite" fetch="LAZY">
      <join-columns>
        <join-column name="jeu_id" referenced-column-name="id"/>
      </join-columns>
    </many-to-one>
    <many-to-one field="qualite" target-entity="Irstea\BdohDataBundle\Entity\Qualite" inversed-by="traductions" fetch="LAZY">
      <join-columns>
        <join-column name="qualite_id" referenced-column-name="id"/>
      </join-columns>
    </many-to-one>
  </entity>
</doctrine-mapping>
