<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity repository-class="Irstea\BdohDataBundle\Entity\Repository\ChroniqueConvertieRepository" name="Irstea\BdohDataBundle\Entity\ChroniqueConvertie" table="ChroniqueConvertie">
    <field name="miseAJour" type="datetime" column="miseAJour" nullable="true"/>
    <one-to-one field="conversion" target-entity="Irstea\BdohDataBundle\Entity\Conversion" fetch="LAZY">
      <cascade>
        <cascade-persist/>
      </cascade>
      <join-columns>
        <join-column name="conversion_id" referenced-column-name="id"/>
      </join-columns>
    </one-to-one>
  </entity>
</doctrine-mapping>
