<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity repository-class="Irstea\BdohDataBundle\Entity\Repository\QualiteRepository" name="Irstea\BdohDataBundle\Entity\Qualite" table="Qualite">
    <id name="id" type="integer" column="id">
      <generator strategy="SEQUENCE"/>
      <sequence-generator sequence-name="Qualite_id_seq" allocation-size="1" initial-value="1"/>
    </id>
    <field name="code" type="string" column="code"/>
    <field name="libelle" type="string" column="libelle" nullable="true"/>
    <field name="libelleEn" type="string" column="libelleEn" nullable="true"/>
    <field name="ordre" type="integer" column="ordre" nullable="true"/>
    <field name="type" type="string" column="type" nullable="true"/>
    <field name="style" type="json_array" column="style" nullable="true"/>
    <one-to-many field="traductions" target-entity="Irstea\BdohDataBundle\Entity\QualiteJeuQualite" mapped-by="qualite" fetch="LAZY"/>
    <many-to-one field="jeu" target-entity="Irstea\BdohDataBundle\Entity\JeuQualite" inversed-by="qualites" fetch="LAZY">
      <join-columns>
        <join-column name="jeu_id" referenced-column-name="id"/>
      </join-columns>
    </many-to-one>
  </entity>
</doctrine-mapping>
