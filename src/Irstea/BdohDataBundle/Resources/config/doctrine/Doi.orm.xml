<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity repository-class="Irstea\BdohDataBundle\Entity\Repository\DoiRepository" name="Irstea\BdohDataBundle\Entity\Doi" table="Doi">
    <id name="id" type="integer" column="id">
      <generator strategy="SEQUENCE"/>
      <sequence-generator sequence-name="Doi_id_seq" allocation-size="1" initial-value="1"/>
    </id>
    <field name="identifiant" type="string" column="identifiant" nullable="false"/>
    <field name="description" type="string" column="description" length="750" nullable="true"/>
    <field name="descriptionEn" type="string" column="descriptionEn" length="750" nullable="true"/>
    <many-to-one field="observatoire" target-entity="Irstea\BdohDataBundle\Entity\Observatoire" inversed-by="dois" fetch="LAZY">
      <join-columns>
        <join-column name="observatoire_id" referenced-column-name="id" on-delete="CASCADE"/>
      </join-columns>
    </many-to-one>
  </entity>
</doctrine-mapping>
