<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity repository-class="Irstea\BdohDataBundle\Entity\Repository\DataSetRepository" name="Irstea\BdohDataBundle\Entity\DataSet" table="DataSet">
    <id name="id" type="integer" column="id">
      <generator strategy="SEQUENCE"/>
      <sequence-generator sequence-name="DataSet_id_seq" allocation-size="1" initial-value="1"/>
    </id>
    <field name="uuid" type="string" column="uuid" nullable="true"/>
    <field name="titre" type="string" column="titre" nullable="false"/>
    <field name="description" type="string" column="description" length="4000" nullable="false"/>
    <field name="genealogie" type="string" column="genealogie" length="4000" nullable="false"/>
    <field name="titreEn" type="string" column="titreEn" nullable="true"/>
    <field name="descriptionEn" type="string" column="descriptionEn" length="4000" nullable="true"/>
    <field name="genealogieEn" type="string" column="genealogieEn" length="4000" nullable="true"/>
    <one-to-many field="chroniques" target-entity="Irstea\BdohDataBundle\Entity\Chronique" mapped-by="dataset" fetch="LAZY"/>
    <many-to-one field="dataConstraint" target-entity="Irstea\BdohDataBundle\Entity\DataConstraint" fetch="LAZY">
      <join-columns>
        <join-column name="dataconstraint_id" referenced-column-name="id"/>
      </join-columns>
    </many-to-one>
    <many-to-one field="inspireTheme" target-entity="Irstea\BdohDataBundle\Entity\InspireTheme" fetch="LAZY">
      <join-columns>
        <join-column name="inspiretheme_id" referenced-column-name="id" on-delete="SET NULL"/>
      </join-columns>
    </many-to-one>
    <many-to-one field="observatoire" target-entity="Irstea\BdohDataBundle\Entity\Observatoire" inversed-by="dataSet" fetch="LAZY">
      <join-columns>
        <join-column name="observatoire_id" referenced-column-name="id" on-delete="SET NULL"/>
      </join-columns>
    </many-to-one>
    <many-to-one field="doi" target-entity="Irstea\BdohDataBundle\Entity\Doi" fetch="LAZY">
      <join-columns>
        <join-column name="doi_id" referenced-column-name="id"/>
      </join-columns>
    </many-to-one>
    <many-to-many field="topicCategories" target-entity="Irstea\BdohDataBundle\Entity\TopicCategory" fetch="LAZY">
      <join-table name="topic_category_dataSet">
        <join-columns>
          <join-column name="dataset_id" referenced-column-name="id" on-delete="CASCADE"/>
        </join-columns>
        <inverse-join-columns>
          <join-column name="topiccategory_id" referenced-column-name="id" on-delete="CASCADE"/>
        </inverse-join-columns>
      </join-table>
    </many-to-many>
    <many-to-many field="portailSearchCriteriaGeology" target-entity="Irstea\BdohDataBundle\Entity\CriteriaGeology" fetch="LAZY">
      <join-table name="criteria_geology_dataSet">
        <join-columns>
          <join-column name="dataset_id" referenced-column-name="id" on-delete="CASCADE"/>
        </join-columns>
        <inverse-join-columns>
          <join-column name="criteriageology_id" referenced-column-name="id" on-delete="CASCADE"/>
        </inverse-join-columns>
      </join-table>
    </many-to-many>
    <many-to-many field="portailSearchCriteriaClimat" target-entity="Irstea\BdohDataBundle\Entity\CriteriaClimat" fetch="LAZY">
      <join-table name="criteria_climat_dataSet">
        <join-columns>
          <join-column name="dataset_id" referenced-column-name="id" on-delete="CASCADE"/>
        </join-columns>
        <inverse-join-columns>
          <join-column name="criteriaclimat_id" referenced-column-name="id" on-delete="CASCADE"/>
        </inverse-join-columns>
      </join-table>
    </many-to-many>
    <many-to-many field="dataManagers" target-entity="Irstea\BdohDataBundle\Entity\PersonneTheia" fetch="LAZY">
      <join-table name="data_manager_dataSet">
        <join-columns>
          <join-column name="dataset_id" referenced-column-name="id"/>
        </join-columns>
        <inverse-join-columns>
          <join-column name="partenaire_id" referenced-column-name="id"/>
        </inverse-join-columns>
      </join-table>
    </many-to-many>
    <many-to-many field="principalInvestigators" target-entity="Irstea\BdohDataBundle\Entity\PersonneTheia" fetch="LAZY">
      <join-table name="principal_investigator_dataSet">
        <join-columns>
          <join-column name="dataset_id" referenced-column-name="id"/>
        </join-columns>
        <inverse-join-columns>
          <join-column name="partenaire_id" referenced-column-name="id"/>
        </inverse-join-columns>
      </join-table>
    </many-to-many>
    <many-to-many field="dataCollectors" target-entity="Irstea\BdohDataBundle\Entity\PersonneTheia" fetch="LAZY">
      <join-table name="data_collector_dataSet">
        <join-columns>
          <join-column name="dataset_id" referenced-column-name="id"/>
        </join-columns>
        <inverse-join-columns>
          <join-column name="partenaire_id" referenced-column-name="id"/>
        </inverse-join-columns>
      </join-table>
    </many-to-many>
    <many-to-many field="projectMembers" target-entity="Irstea\BdohDataBundle\Entity\PersonneTheia" fetch="LAZY">
      <join-table name="project_member_dataSet">
        <join-columns>
          <join-column name="dataset_id" referenced-column-name="id"/>
        </join-columns>
        <inverse-join-columns>
          <join-column name="partenaire_id" referenced-column-name="id"/>
        </inverse-join-columns>
      </join-table>
    </many-to-many>
  </entity>
</doctrine-mapping>
