<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="Irstea\BdohDataBundle\Entity\JeuBareme" table="JeuBareme">
    <id name="id" type="integer" column="id">
      <generator strategy="SEQUENCE"/>
      <sequence-generator sequence-name="JeuBareme_id_seq" allocation-size="1" initial-value="1"/>
    </id>
    <field name="dateCreation" type="datetime" column="dateCreation" nullable="true"/>
    <field name="delaiPropagation" type="float" column="delaiPropagation" nullable="true"/>
    <field name="valueLimitTransformationType" type="string" column="valueLimitTransformationType" nullable="true"/>
    <field name="valueLimitPlaceholder" type="float" column="valueLimitPlaceholder" nullable="true"/>
    <one-to-many field="baremeJeuBaremes" target-entity="Irstea\BdohDataBundle\Entity\BaremeJeuBareme" mapped-by="jeuBareme" fetch="LAZY">
      <cascade>
        <cascade-persist/>
      </cascade>
      <order-by>
        <order-by-field name="debutValidite" direction="ASC"/>
      </order-by>
    </one-to-many>
    <many-to-one field="transformation" target-entity="Irstea\BdohDataBundle\Entity\Transformation" inversed-by="jeuBaremesHistoriques" fetch="LAZY">
      <join-columns>
        <join-column name="transformation_id" referenced-column-name="id" on-delete="CASCADE"/>
      </join-columns>
    </many-to-one>
  </entity>
</doctrine-mapping>
