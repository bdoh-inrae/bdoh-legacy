<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity repository-class="Irstea\BdohDataBundle\Entity\Repository\PartenaireRepository" name="Irstea\BdohDataBundle\Entity\Partenaire" table="Partenaire">
    <unique-constraints>
      <unique-constraint name="unique_partenaire_by_obs" columns="nom,observatoire_id"/>
    </unique-constraints>
    <entity-listeners>
      <entity-listener class="Irstea\BdohDataBundle\Doctrine\Listener\DocumentedEntityListener"/>
    </entity-listeners>
    <id name="id" type="integer" column="id">
      <generator strategy="SEQUENCE"/>
      <sequence-generator sequence-name="Partenaire_id_seq" allocation-size="1" initial-value="1"/>
    </id>
    <field name="nom" type="string" column="nom"/>
    <field name="lien" type="string" column="lien" nullable="true"/>
    <field name="pathLogo" type="string" column="pathLogo" nullable="true"/>
    <field name="estFinanceur" type="boolean" column="estFinanceur"/>
    <field name="iso" type="string" column="iso" nullable="true"/>
    <field name="scanR" type="string" column="scanR" nullable="true"/>
    <many-to-one field="typeFundings" target-entity="Irstea\BdohDataBundle\Entity\TypeFunding" fetch="LAZY">
      <join-columns>
        <join-column name="typefundings_id" referenced-column-name="id" on-delete="SET NULL"/>
      </join-columns>
    </many-to-one>
    <many-to-one field="observatoire" target-entity="Irstea\BdohDataBundle\Entity\Observatoire" inversed-by="partenaires" fetch="LAZY">
      <cascade>
        <cascade-persist/>
      </cascade>
      <join-columns>
        <join-column name="observatoire_id" referenced-column-name="id"/>
      </join-columns>
    </many-to-one>
  </entity>
</doctrine-mapping>
