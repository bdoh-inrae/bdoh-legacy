<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity repository-class="Irstea\BdohDataBundle\Entity\Repository\PointControleRepository" name="Irstea\BdohDataBundle\Entity\PointControle" table="PointControle">
    <id name="id" type="integer" column="id">
      <generator strategy="SEQUENCE"/>
      <sequence-generator sequence-name="PointControle_id_seq" allocation-size="1" initial-value="1"/>
    </id>
    <field name="date" type="datetimems" column="date"/>
    <field name="valeur" type="float" column="valeur" nullable="true"/>
    <field name="minimum" type="float" column="minimum" nullable="true"/>
    <field name="maximum" type="float" column="maximum" nullable="true"/>
    <many-to-one field="chronique" target-entity="Irstea\BdohDataBundle\Entity\ChroniqueContinue" inversed-by="pointsControle" fetch="LAZY">
      <join-columns>
        <join-column name="chronique_id" referenced-column-name="id" on-delete="CASCADE"/>
      </join-columns>
    </many-to-one>
    <many-to-one field="qualite" target-entity="Irstea\BdohDataBundle\Entity\Qualite" fetch="LAZY">
      <join-columns>
        <join-column name="qualite_id" referenced-column-name="id"/>
      </join-columns>
    </many-to-one>
  </entity>
</doctrine-mapping>
