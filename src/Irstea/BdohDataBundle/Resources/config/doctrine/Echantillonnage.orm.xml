<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity repository-class="Irstea\BdohDataBundle\Entity\Repository\EchantillonnageRepository" name="Irstea\BdohDataBundle\Entity\Echantillonnage" table="Echantillonnage">
    <id name="id" type="integer" column="id">
      <generator strategy="SEQUENCE"/>
      <sequence-generator sequence-name="Echantillonnage_id_seq" allocation-size="1" initial-value="1"/>
    </id>
    <field name="code" type="string" column="code" unique="true" nullable="true"/>
    <field name="nom" type="string" column="nom" unique="true"/>
    <field name="nomEn" type="string" column="nomEn" unique="true" nullable="true"/>
    <field name="ordreSortie" type="integer" column="ordreSortie" unique="true" nullable="true"/>
    <field name="hasDirection" type="boolean" column="hasDirection" nullable="true"/>
  </entity>
</doctrine-mapping>
