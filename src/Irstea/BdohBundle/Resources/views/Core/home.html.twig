{% extends 'layout.html.twig' %}

{% block title %}{{ 'accueilObservatoires'|trans }}{% endblock title %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('bundles/irsteabdohconsult/vendor/leaflet/leaflet.js') }}"></script>
    <script src="{{ asset('bundles/irsteabdohconsult/js/stations-map.js') }}" defer></script>
{% endblock javascripts %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/irsteabdohconsult/vendor/leaflet/leaflet.css') }}" type="text/css"/>
    <link rel="stylesheet" href="{{ asset('bundles/irsteabdohconsult/css/homes.css') }}" type="text/css"/>
{% endblock stylesheets %}

{#
 # L'accueil du portail : la carte de toutes les stations en tête, la présentation, puis une fiche par observatoire.
 # Survoler une fiche allume ses stations sur la carte (stations-map.js, data-map-observatoire) ; rien ne bouge.
 # Le texte entier de chaque observatoire est sur sa page ; la fiche n'en montre que le début, en texte simple.
 #}
{% block main %}
    <h1>{{ 'home.title'|trans }}</h1>

    <div class="col-md-24 portal-home">
        {% include 'Core/stations-map.html.twig' with {stations: mapStations, france: true, title: false, height: 440} %}

        <h2>{{ 'presentation'|trans }}</h2>
        <div class="portal-presentation">
            {{ 'accueilMessage'|trans|replace({"\n": "<br />"})|raw }}
        </div>

        <h2>{{ 'Observatoire'|trans({}, 'entitiesPlurals') }}</h2>
        {% set english = app.session.get('_locale')|slice(0, 2) == 'en' %}
        <div class="observatory-cards">
            {% for obs in allObservatoires() %}
                {% set placed = mapStations|filter(s => s.slug == obs.slug and s.lat is not null)|length %}
                <a class="observatory-card" href="{{ path('bdoh_home', {'_observatoire' : obs.slug}) }}"
                   data-map-observatoire="{{ obs.nom }}">
                    <span class="observatory-card-head">
                        <h3 class="observatory-card-name">{{ obs.nom }}</h3>
                        {% if obs.pathLogo %}
                            <img class="observatory-card-logo" src="{{ asset(obs.pathLogo) }}" alt="">
                        {% endif %}
                    </span>
                    <span class="observatory-card-text">
                        {{- (english ? obs.descriptionEn|default(obs.description) : obs.description)|excerpt -}}
                    </span>
                    <span class="observatory-card-count">{{ 'map.onMap'|trans({'%count%': placed}) }}</span>
                </a>
            {% endfor %}
        </div>
    </div>
{% endblock main %}
