{#- La langue (Lou, 2026-11-15) : « FR EN », celle de la page en évidence, l'autre en lien ; plus de drapeaux, ni de
 # menu pour un seul autre choix. Le nom entier se lit au survol. -#}
<li class="lang-switch">
    {% if app.session.get('_locale') == 'en' %}
        <a href="{{ path('irstea_bdoh_internationalisation', {'_locale' : 'fr'}) }}" lang="fr" title="Français">FR</a>
        <span class="lang-current" aria-current="true" title="English">EN</span>
    {% else %}
        <span class="lang-current" aria-current="true" title="Français">FR</span>
        <a href="{{ path('irstea_bdoh_internationalisation', {'_locale' : 'en'}) }}" lang="en" title="English">EN</a>
    {% endif %}
</li>
