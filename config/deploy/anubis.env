# Les réglages d'Anubis devant BDOH, écrits par make vm-anubis dans /etc/anubis/bdoh-@NOM@.env, que lit le service
# anubis@bdoh-@NOM@ du paquet. @NAME@ : le nom de DEFAULT_URI. dev/plans/2026-11-26_ai-robots.md.

# Sur l'interface locale : l'Apache du port 443 lui passe tout, et lui passe à BDOH (config/deploy/apache-site.conf)
BIND=127.0.0.1:8923
TARGET=http://127.0.0.1:3001
POLICY_FNAME=/etc/anubis/bdoh-@NOM@.botPolicies.yaml

# Après le défi, Anubis ne renvoie que vers le site lui-même
REDIRECT_DOMAINS=@NAME@

# robots.txt est celui de BDOH (public/robots.txt), pas celui d'Anubis
SERVE_ROBOTS_TXT=false

# L'adresse que montrent ses pages d'erreur, pour qu'un humain bloqué puisse écrire
WEBMASTER_EMAIL=bdoh.support@listes.inrae.fr
