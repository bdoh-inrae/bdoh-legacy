# Configuration de chaque installation : copiée de .env.example, elle peut porter des secrets.
/.env
/.env.local
/.env.*.local
/config/secrets/prod/prod.decrypt.private.php
/var/
/vendor/
/node_modules/
/public/bundles/
__pycache__/
/public/assets/
/public/js/
/public/css/themes/
/public/uploads/

# Notes du portage qui ne se publient pas (points de sécurité sensibles) : lues par chaque session,
# jamais envoyées. dev/local/README.md dit ce qui y va.
/dev/local/*
!/dev/local/README.md
