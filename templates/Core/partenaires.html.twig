{% from 'macros.html.twig' import logo %}
{#-- 'Partenaires' line : les logos sur une ligne, sous un filet (2026-11-12, Lou)
================================================== -#}
<div id="partenaires">
    {{ logo('Irstea', logo_long_link_parameters, 'https://www.inrae.fr/') }}
    {% if currentObservatoire() %}
        {% for partenaire in currentObservatoire().partenaires %}
            {% if partenaire.pathLogo %}
                {{ logo(partenaire.nom, partenaire.pathLogo, partenaire.lien) }}
            {% endif %}
        {% endfor %}
    {% endif %}
</div>
{#-- END_'Partenaires' line -#}
