{%- from 'macros.html.twig' import richLink %}
{#-- User bar : la recherche avancée de l'observatoire à gauche, le compte à droite (2026-11-12, Lou). Sans
 # observatoire (le portail), ni l'une ni l'autre : les pages du compte ont l'adresse d'un observatoire.
================================================== -#}
<div id="userbar" class="navbar navbar-inverse">
    {% if currentObservatoire() is not null %}
        <ul class="nav navbar-nav">
            {% if currentObservatoire().hasChronique() %}
                <li>{{ richLink(path('bdoh_consult_advancedSearch'), 'advancedSearch', 'zoom', 'both') }}</li>
            {% endif %}
        </ul>
        <ul class="nav navbar-nav navbar-right">
            {% include is_granted('ROLE_USER') ?
               '@IrsteaBdohSecurity/UserBar/connected-menu.html.twig' :
               '@IrsteaBdohSecurity/UserBar/anonymous-menu.html.twig'
            %}
        </ul>
    {% endif %}
</div>
{#-- END_User bar -#}
