{#-- Navigation bar : le choix d'un observatoire, puis celui qu'on consulte, à gauche ; l'aide et la langue à droite
 # (2026-11-12, Lou). « Consultation des données » devient « Recherche avancée », la page où il mène, dans la barre
 # du dessous.
================================================== -#}
<nav id="navbar" class="navbar navbar-default">
    <ul class="nav navbar-nav">
        {% include "Core/observatoires-selector.html.twig" %}
        {% if currentObservatoire() %}
            <li class="divider"></li>
            <li class="current-observatoire"><a href="{{ path('bdoh_home') }}">{{ currentObservatoire().nom }}</a></li>
        {% endif %}
    </ul>

    {#-- Contact and language links  -#}
    <ul class="nav navbar-nav navbar-right">
        {% if currentObservatoire() %}
            <li><a href="{{ path('bdoh_consult_contact') }}"><small>{{ 'contactHelp'|trans }}</small></a></li>
            <li class="divider"></li>
        {% endif %}
        {% include "@IrsteaBdohInternationalisation/select-lang.html.twig" %}
    </ul>
</nav>
{#-- END_Navigation bar -#}
