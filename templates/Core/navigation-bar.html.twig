{%- from 'macros.html.twig' import richLink %}
{#-- Navigation bar : ce qui tient à l'observatoire (Lou, 2026-11-13). À gauche, le choix d'un observatoire, celui
 # qu'on consulte et sa recherche (l'ancienne « Consultation des données », puis « Recherche avancée »), à sa place de
 # l'ancien ; à droite, l'aide et la langue. Le compte est dans la barre du dessous.
================================================== -#}
<nav id="navbar" class="navbar navbar-default">
    <ul class="nav navbar-nav">
        {% include "Core/observatoires-selector.html.twig" %}
        {% if currentObservatoire() %}
            <li class="divider"></li>
            <li class="current-observatoire"><a href="{{ path('bdoh_home') }}" title="{{ currentObservatoire().nom }}">{{ currentObservatoire().nom }}</a></li>
            {% if currentObservatoire().hasChronique() %}
                <li class="divider"></li>
                <li>{{ richLink(path('bdoh_consult_advancedSearch'), 'advancedSearch', 'zoom', 'both') }}</li>
            {% endif %}
        {% endif %}
    </ul>

    {#-- Contact and language links  -#}
    <ul class="nav navbar-nav navbar-right">
        {% if currentObservatoire() %}
            <li><a href="{{ path('bdoh_consult_contact') }}"><small>{{ 'contactHelp'|trans }}</small></a></li>
            <li class="divider"></li>
        {% endif %}
        {% include "@IrsteaBdohInternationalisation/select-lang.html.twig" %}
    </ul>
</nav>
{#-- END_Navigation bar -#}
