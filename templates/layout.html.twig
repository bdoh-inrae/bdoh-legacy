{%- from 'macros.html.twig' import pageTitle, breadcrumbRoot %}

<!DOCTYPE html>
<html lang="{{ app.request.locale|split('_')[0] }}">
<head>
    {% block htmlmeta %}
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    {% endblock %}
    <link rel="shortcut icon" href="{{ asset('favicon.ico') }}"/>
    <title>{% block title %}{{ pageTitle() }}{% endblock title %}</title>

    {#-- Common stylesheets #}
    <link rel="stylesheet" href="{{ asset('assets/bdoh.css') }}" />

    {#-- Additionnal stylesheets #}
    {%- block stylesheets %}{% endblock stylesheets -%}

    {#-- Customized theme stylesheets #}
    <link rel="stylesheet" href="{{ asset(themeCssFile()) }}">
</head>
<body>
<div id="page" class="container">

    {#-- Header
    ================================================== #}
    <div id="header" class="row">
        {#-- « BDOH », qui mène au portail, à la place du logo de l'observatoire ou d'INRAE (2026-11-12, Lou) : le lien
         # vers le site de l'observatoire passe à côté du titre de son accueil, les logos restent dans ses fiches et
         # dans le pied de page -#}
        <div id="logo"><a class="bdoh-brand" href="{{ path('bdoh_all_home') }}">BDOH</a></div>
        <div id="header-bars">
            {% include "Core/navigation-bar.html.twig" -%}
            {% include "Core/user-bar.html.twig" -%}
        </div>
    </div>
    {#-- END_Header --#}

    {#-- Breadcrumb : par défaut, son début, « BDOH », puis l'observatoire de la page s'il y en a un. Toute page en a
     # un, pour que le contenu commence toujours au même endroit (2026-11-12, Lou).
    ================================================== #}
    {% block breadcrumb -%}
    <ul class="breadcrumb">
        {%- if currentObservatoire() %}
        {{ breadcrumbRoot(false) }}
        {%- else %}
        <li class="active">BDOH</li>
        {%- endif %}
    </ul>
    {% endblock breadcrumb -%}

    {#-- Notice
    ================================================== #}
    <div id="notices" data-notices="{{ app.session.flashbag.all() | default([]) | json_encode | e('html_attr') }}"></div>

    {#-- Main content
    ================================================== #}
    <div id="main" class="row">
        {% block main -%}
        {% endblock main -%}
    </div>
    {#-- END_Main content #}


    {#-- Footer : un filet, les logos, puis les mentions légales (2026-11-12, Lou)
    ================================================== #}
    <div id="footer">
        {% include "Core/partenaires.html.twig" %}
        {% include "Core/mentionLegale.html.twig" %}
    </div>
    {#-- END_Footer #}
</div>

{% block body_tail -%}
{% endblock body_tail -%}

{#-- Common javascript #}
{% if app.debug %}
    <script src="http://{{ app.request.host }}:35729/livereload.js"></script>
{% endif %}
<script src="{{ asset('assets/manifest.js') }}"></script>
<script src="{{ asset('assets/vendor.js') }}"></script>
<script src="{{ asset('assets/bdoh.js') }}"></script>
<script src="{{ asset('assets/locales/' ~ (app.request.locale[:2]) ~ '.js') }}"></script>

{#-- Additionnal javascript #}
{%- block javascripts -%}{% endblock javascripts -%}
</body>
</html>
