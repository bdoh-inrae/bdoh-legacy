# Configuration du nouveau BDOH. Chaque installation en fait une copie, .env, hors du dépôt
# (make app-install la crée en développement) ; en production, .env porte les vrais secrets et
# n'est lisible que par le serveur web.

# dev en développement, prod en production.
APP_ENV=dev
# Clé des jetons CSRF et des sessions ; en production, une valeur aléatoire propre au serveur.
APP_SECRET=dev-not-a-secret

# La base : en développement, la base de travail réduite du serveur de compose.yaml (PostgreSQL 18).
DATABASE_URL="postgresql://bdoh@db:5432/bdoh_small?serverVersion=18&charset=utf8"

# Adresse des liens écrits hors d'une page (courriels, tâches).
DEFAULT_URI=http://172.30.26.10

# Les noms sous lesquels on joint BDOH, en expression régulière : les autres reçoivent une erreur 400,
# et aucun lien envoyé par courriel ne porte un nom choisi par le visiteur. En production, le nom du
# serveur, par exemple '^bdoh\.inrae\.fr$' ; en développement, compose.yaml le règle.
#SYMFONY_TRUSTED_HOSTS=
# Derrière un proxy inverse seulement : son adresse, pour que BDOH voie celle des visiteurs (limites
# de fréquence par adresse IP, cookies sécurisés en HTTPS). Sur la VM, vide : Apache et Anubis transmettent
# l'adresse et le HTTPS autrement (mod_remoteip, config/deploy/apache-site.conf).
#SYMFONY_TRUSTED_PROXIES=
# Les requêtes de données des graphiques par adresse IP et par heure, sans compte ni avec (GraphDataLimiter) : 600
# par défaut. Une page de chronique en demande deux.
#GRAPH_DATA_PER_HOUR=600
# Les valeurs exactes qu'un graphique reçoit au plus ; au-delà, le minimum et le maximum de chaque tranche, et le
# graphique se dit allégé : 50 000 par défaut, comme l'ancien.
#GRAPH_MAX_POINTS=50000

# Envoi des courriels (exports, comptes) : en développement, rien ne part ; en production, le
# serveur SMTP, par exemple smtp://hote:25.
MAILER_DSN=null://null
# Pendant les essais sur le vrai dump, tant que le site n'est pas ouvert : tout courriel part à MAILER_DIVERT_TO,
# et n'arrive à son destinataire que s'il est dans MAILER_ALLOWED_RECIPIENTS, des expressions régulières séparées par
# des virgules (`make test-contacts` l'écrit, dans allowed-recipients.env). La liste n'agit que si MAILER_DIVERT_TO est
# rempli : seule, elle est ignorée et tout part aux vrais destinataires. Un courriel dont un destinataire n'est pas dans la
# liste commence son objet par `[ESSAIS : NON ENVOYÉ À …]` (TrialMailMarker). À vider à l'ouverture au public.
#MAILER_DIVERT_TO=
#MAILER_ALLOWED_RECIPIENTS=

# Clé qui chiffre les mots de passe Theia des observatoires en base : 32 octets en hexadécimal. En
# production, une clé propre au serveur (php -r 'echo bin2hex(random_bytes(32));') ; en développement,
# compose.yaml en règle une.
#THEIA_PASSWORD_SECRET_KEY=

# Adresse où partent les fiches des observatoires vers Theia/OZCAR, et schéma qui les contrôle : par
# défaut, ceux du portail (config/services.yaml) ; la comparaison les remplace par les siens.
#THEIA_SEND_URI=https://in-situ.theia-land.fr/data/
#THEIA_SCHEMA_URI=https://in-situ.theia-land.fr/json-schema/pivotSchemaDraft7.json

# La place des archives d'export en attente d'être téléchargées, en octets ; 20 Go si elle n'est pas réglée.
#EXPORTS_MAX_BYTES=21474836480

# Les seuils de volume d'un export, en valeurs écrites, toutes chroniques de la demande réunies : au-delà du premier,
# un compte est demandé ; au-delà du second, la demande est refusée. Valeurs lues (à l'identique, interpolées) et
# valeurs calculées (moyenne, cumul), qui coûtent bien plus cher. Par défaut, les valeurs ci-dessous ; à régler
# d'après la machine (dev/deploy/README.md, « Mesurer les exports »), sans redémarrer : chaque page relit ce fichier.
#EXPORT_READ_WITHOUT_ACCOUNT=5000000
#EXPORT_READ_MAX=50000000
#EXPORT_COMPUTED_WITHOUT_ACCOUNT=100000
#EXPORT_COMPUTED_MAX=1200000
