# Configuration du nouveau BDOH. Chaque installation en fait une copie, .env, hors du dépôt
# (make app-install la crée en développement) ; en production, .env porte les vrais secrets et
# n'est lisible que par le serveur web.

# dev en développement, prod en production.
APP_ENV=dev
# Clé des jetons CSRF et des sessions ; en production, une valeur aléatoire propre au serveur.
APP_SECRET=dev-not-a-secret

# La base : en développement, la base de travail réduite du serveur PostgreSQL 17 de compose.yaml.
DATABASE_URL="postgresql://bdoh@db:5432/bdoh_small?serverVersion=17&charset=utf8"

# Adresse des liens écrits hors d'une page (courriels, tâches).
DEFAULT_URI=http://172.30.26.10

# Envoi des courriels (exports, comptes) : en développement, rien ne part ; en production, le
# serveur SMTP, par exemple smtp://hote:25.
MAILER_DSN=null://null
