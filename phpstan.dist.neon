# Analyse statique du code porté : make phpstan. Le niveau monte avec le portage.
parameters:
    level: 1
    paths:
        - src
    # Pas encore portés : chaque module retire ses lignes (ROADMAP.md, portage).
    excludePaths:
        - src/Irstea/BdohConsultBundle/Service/JsonSchema
    ignoreErrors:
        # Le module Theia/OZCAR n'est pas encore porté.
        - '#Irstea\\BdohTheiaOzcarBundle\\#'
        # Chaque commande d'export définit sa sorte d'extraction.
        - '#undefined constant static\(Irstea\\BdohDataBundle\\Command\\AbstractExportCommand\)::EXTRACTOR_TYPE#'
        # Code de l'ancien BDOH, gardé tel quel : des chemins que PHPStan ne suit pas (états des erreurs
        # d'import, tests toujours vrais) laissent une variable ou un retour indéfinis en apparence.
        -
            message: '#might not be defined|but return statement is missing#'
            path: src/Irstea/BdohAdminBundle/*
        # Clés en double, comme dans l'ancien : la dernière l'emporte.
        -
            message: '#duplicate keys#'
            path: src/Irstea/BdohBundle/Resources/translations/*
    tmpDir: var/phpstan
